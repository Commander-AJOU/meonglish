<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FF1E40AF" />
                    <corners android:radius="60dp" />
                </shape>
            </item>
            <item android:top="6dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FF3B82F6" />
                    <stroke android:width="5dp" android:color="#FF93C5FD" />
                    <corners android:radius="60dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FF1E40AF" />
                    <corners android:radius="60dp" />
                </shape>
            </item>
            <item android:top="0dp" android:bottom="10dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FF3B82F6" />
                    <stroke android:width="5dp" android:color="#FF93C5FD" />
                    <corners android:radius="60dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
